APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_ADMIN_DOMAIN=admin.localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Provider — dipakai OCR KTP & fitur AI lain
# Pilihan: claude | gemini | mock
AI_PROVIDER=claude
# Opsional: override provider khusus OCR (kosong = ikut AI_PROVIDER)
OCR_PROVIDER=
AI_TIMEOUT=30

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-lite

# WhatsApp Notifikasi
WHATSAPP_BASE_URL=http://127.0.0.1:5003
WHATSAPP_USERNAME=your_basic_auth_username
WHATSAPP_PASSWORD=your_basic_auth_password
WHATSAPP_TEST_NUMBER=
# Jeda minimum antar pengiriman pesan (detik) untuk hindari blokir WA.
# Set keduanya 0 untuk menonaktifkan throttle. Hanya aktif di non-local/testing.
WHATSAPP_THROTTLE_MIN=20
WHATSAPP_THROTTLE_MAX=30

# Google Analytics (Firebase)
FIREBASE_MEASUREMENT_ID=

# Backup Database
# Path ke binary mysqldump. Di server Ubuntu biarkan 'mysqldump' (sudah di PATH).
# Di Laragon lokal isi path absolut, mis: D:\laragon\bin\mysql\mysql-8.x\bin\mysqldump.exe
DB_DUMP_BINARY_PATH=mysqldump
# Jumlah file backup yang disimpan per jenis (daily/weekly). 1 = hanya yang terbaru.
BACKUP_KEEP=1
